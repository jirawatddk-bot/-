# Server Configuration
PORT=3000
NODE_ENV=development

# Database Path
DB_PATH=./database/isan_quotes.db

# LLM Configuration (Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini # gemini | mock

# Facebook Graph API Configuration
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_DRY_RUN=true # Set false for real FB posting

# Cron Schedule Configuration
# 3 Times a day: 06:00 AM, 12:00 PM, 06:00 PM ("0 6,12,18 * * *")
CRON_SCHEDULE=0 6,12,18 * * *
AUTO_SCHEDULE_ENABLED=true
